# ============================================================
# Mailcoy — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub.
# ============================================================

# Supabase
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vite (client-side) — same values as above
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App Security
APP_USER_CONNECTION_KEY_SECRET=

# AI Support Engine (Groq — free at console.groq.com)
GROQ_API_KEY=

# Optional: Gemini fallback AI key
# GEMINI_API_KEY=

# Optional: Resend for transactional email (resend.com)
# RESEND_API_KEY=
# Required in production: Svix webhook signing secret for inbound email verification (from resend.com dashboard → Webhooks)
# RESEND_WEBHOOK_SECRET=

# Optional: Paystack for payments (dashboard.paystack.com)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
